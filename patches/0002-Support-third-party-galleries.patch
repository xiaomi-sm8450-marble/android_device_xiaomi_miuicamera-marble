     invoke-static {v0, v3, v2}, Lcom/android/camera/log/Log;->w(Ljava/lang/String;Ljava/lang/String;Ljava/lang/Throwable;)V
 
-    invoke-static {}, Lid/b;->q2()Lid/b;
-
-    move-result-object v0
-
-    invoke-virtual {v0}, Lid/b;->C2()Z
-
-    move-result v0
-
-    if-nez v0, :cond_0
-
